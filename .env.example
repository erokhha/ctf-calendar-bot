# Заполните только в локальном .env. Не включайте реальные ключи в отчёт/GitHub.
TELEGRAM_BOT_TOKEN=
WEATHER_API_KEY=
CAT_API_KEY=
CAT_BREED=beng
HTTP_TIMEOUT_SECONDS=12
CTF_LIMIT=10
CTF_DAYS=90
DATABASE_PATH=data/chats.sqlite3
LOG_PATH=logs/bot.log
LOG_LEVEL=INFO
# При необходимости задайте адрес прокси. В PythonAnywhere обычно достаточно
# системных HTTP_PROXY/HTTPS_PROXY: aiohttp и HTTPX используют trust_env=True.
# TELEGRAM_PROXY_URL=http://proxy.server:3128
